{
  "name": "hamlog-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:url-hash": "node --test src/scripts/urlHash/__tests__/urlHash.test.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "load-fontello": "load-fontello",
    "server-build": "rolldown --config rolldown.config.server.ts",
    "server-start": "rolldown --config rolldown.config.server.ts && node server-dist/index.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@kuankuan/assist-2026": "^0.1.20",
    "@kuankuan/k-server": "^1.2.1",
    "@kuankuan/log-control": "^0.2.3",
    "ajv": "^8.20.0",
    "color": "^5.0.3",
    "ejs": "^7.0.2",
    "nodemailer": "^10.6.1",
    "rolldown": "^1.3.3",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.7.0",
    "compressing": "^2.1.5",
    "cssnano": "^9.9.0",
    "esbuild": "^0.28.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postcss-preset-env": "^11.6.3",
    "rollup-plugin-visualizer": "^7.1.3",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.8",
    "vite-plugin-inspect": "12.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@12.4.1"
}