    "ajv": "^8.20.0",
    "color": "^5.0.3",
    "ejs": "^7.0.2",
    "nodemailer": "^10.2.1",
    "rolldown": "^1.2.15",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/ejs": "^3.1.5",
