    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.5",
    "vite-plugin-inspect": "12.1.0",
