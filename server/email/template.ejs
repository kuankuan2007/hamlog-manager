<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= subject %></title>
  </head>
  <body>
    <div role="main">
<div class="content"><% if (contentType === 'text') { %>
<p style="white-space: pre-wrap;"><%= body %></p>
<% } else { %>
<%= body %>
<% } %></div>
<div role="footer">
<hr style="border-top-width: 1.5px;opacity: 0.8;width: 200px;margin: 20px 0 0 0;padding: 0;" />
<table>
    <tbody>
        <tr>
            <td rowspan="2" style="width: 55px;height: 55px;">
                <img alt="" style="height: 100%;width: 100%;border-radius: 99999px;" src="<%= meta.myPhoto %>" />
            </td>
            <td>
                <div style="font-size: 18px;font-weight: bold;"><%= meta.myCallsign %></div>
            </td>
        </tr>
        <tr>
            <td>
                <div style="font-size: 12px;">中国业余无线电台</div>
                <div style="font-size: 12px;">Personal Amateur Radio Station OF P.R China</div>
            </td>
        </tr>
    </tbody>
</table>
</div>
    </div>
  </body>
</html>
