<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= subject %></title>
  </head>
  <body>
    <div role="main">
<div class="content"><% if (contentType === 'text') { %>
<p style="white-space: pre-wrap;"><%= body %></p>
<% } else { %>
<%= body %>
<% } %></div>
<div role="footer" style="
    display: flex;
    column-gap: 0.5em;
    font-size: 0.6em;
    align-items: center;
">
<table>
    <tbody>
        <tr>
            <td rowspan="2" style="width: 50px;height: 50px;">
                <img alt="" style="height: 100%;width: 100%;border-radius: 99999px;" src="data:image/jpeg;base64,">
            </td>
            <td>
                <div style="font-size: 18px;font-weight: bold;"><%= meta.myCallsign %></div>
            </td>
        </tr>
        <tr>
            <td>
                <div style="font-size: 12px;">中国业余无线电台</div>
                <div style="font-size: 12px;">Personal Amateur Radio Station OF P.R China</div>
            </td>
        </tr>
    </tbody>
</table>
</div>
    </div>
  </body>
</html>
