{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["server/**/*", "schema/**/*", "src/types/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "declaration": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./server-dist",
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "@server/*": ["./server/*"],
      "@schema/*": ["./schema/*"]
    }
  }
}
